# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are bundled into the app.
# RevenueCat → Project settings → API keys → Google Play public key (starts with goog_).
EXPO_PUBLIC_RC_ANDROID_KEY=
# AdMob (production builds only; dev builds always use Google test ads).
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
# Testing only: show the EEA consent form (never set for store builds).
EXPO_PUBLIC_UMP_DEBUG_EEA=
# Sentry (crash reports). Source-map upload also needs SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT.
SENTRY_DSN=
